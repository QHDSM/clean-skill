{
  "schema": "disk-cleanup-targets/v1",
  "updated": "2026-11-16",
  "about": "结构化候选清单：把『清什么』写成数据，代码只做展开与校验。分层结构参考 BleachBit CleanerML 的 cleaner/option/action 与 running/var 概念（GPL-3.0-or-later），本文件内容为独立编写，未复制其 cleaner 定义。本文件只产出候选路径，不执行任何动作；执行仍由 clean.py 读 plan.json 完成。",
  "categories": ["system", "browser", "development", "application", "protection"],
  "cleaners": [
    {
      "id": "user-temp",
      "label": "当前用户临时目录",
      "description": "应用与安装器写入的临时文件，进程退出后通常不再需要",
      "category": "system",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "按需重建",
      "paths": ["%LOCALAPPDATA%\\Temp"],
      "exclude": [],
      "running": [],
      "requires_admin": false,
      "note": "正在被进程占用的文件应在执行时被拒绝，不要强杀进程"
    },
    {
      "id": "windows-temp",
      "label": "系统临时目录",
      "description": "系统级 Temp，服务与安装器共用",
      "category": "system",
      "status": "release",
      "risk": "caution",
      "action": "delete",
      "regenerates": "按需重建",
      "paths": ["%SystemRoot%\\Temp"],
      "exclude": [],
      "running": [],
      "requires_admin": true,
      "note": "位于 C:\\Windows 树下，会被 clean.py 的 DENY_TREE 整树拒绝；列出它是为了让冲突可见，而不是绕过"
    },
    {
      "id": "crash-dumps",
      "label": "崩溃转储",
      "description": "应用崩溃时写出的 user-mode dump",
      "category": "system",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "下次崩溃时重建",
      "paths": ["%LOCALAPPDATA%\\CrashDumps"],
      "exclude": [],
      "running": [],
      "requires_admin": false,
      "note": "若用户正在排查故障，先确认这些 dump 不再需要"
    },
    {
      "id": "thumbnail-cache",
      "label": "缩略图缓存",
      "description": "资源管理器生成的缩略图数据库",
      "category": "system",
      "status": "release",
      "risk": "caution",
      "action": "delete",
      "regenerates": "浏览文件夹时重建，首次会变慢",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*.db"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "explorer.exe", "same_user": true }],
      "requires_admin": false,
      "note": "被 explorer 占用时删除会失败；不要为了删它去结束 explorer"
    },
    {
      "id": "windows-update-download",
      "label": "Windows 更新下载缓存",
      "description": "已安装更新的安装包残留",
      "category": "system",
      "status": "release",
      "risk": "caution",
      "action": "delete",
      "regenerates": "需要时重新下载",
      "paths": ["%SystemRoot%\\SoftwareDistribution\\Download"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "TrustedInstaller.exe", "same_user": false }],
      "requires_admin": true,
      "note": "位于 C:\\Windows 树下，会被 DENY_TREE 拒绝；系统支持的做法是 DISM /StartComponentCleanup，而不是删目录"
    },
    {
      "id": "chrome-cache",
      "label": "Chrome 缓存",
      "description": "每个配置文件的 HTTP 缓存、代码缓存与 GPU 缓存",
      "category": "browser",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "重新访问网站时重建",
      "paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache\\Cache_Data",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache"
      ],
      "exclude": [],
      "running": [{ "type": "exe", "value": "chrome.exe", "same_user": true }],
      "requires_admin": false,
      "note": "只清缓存，不碰 History/Cookies/Login Data；浏览器运行时部分文件会删除失败"
    },
    {
      "id": "edge-cache",
      "label": "Edge 缓存",
      "description": "每个配置文件的 HTTP 缓存、代码缓存与 GPU 缓存",
      "category": "browser",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "重新访问网站时重建",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache\\Cache_Data",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache"
      ],
      "exclude": [],
      "running": [{ "type": "exe", "value": "msedge.exe", "same_user": true }],
      "requires_admin": false,
      "note": "同上，不碰会话、书签与密码库"
    },
    {
      "id": "firefox-cache",
      "label": "Firefox 缓存",
      "description": "每个配置文件的 cache2",
      "category": "browser",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "重新访问网站时重建",
      "paths": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "firefox.exe", "same_user": true }],
      "requires_admin": false,
      "note": "不同版本的缓存目录可能落在 Roaming 下，缺失时按不存在处理"
    },
    {
      "id": "npm-cache",
      "label": "npm 缓存",
      "description": "内容寻址的包缓存（_cacache）",
      "category": "development",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "下次 npm install 重新下载",
      "paths": ["%LOCALAPPDATA%\\npm-cache\\_cacache"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "node.exe", "same_user": true }],
      "requires_admin": false,
      "note": "等价于 npm cache clean --force，但由我们走回收站，可撤销"
    },
    {
      "id": "pip-cache",
      "label": "pip 缓存",
      "description": "下载的 wheel 与 HTTP 缓存",
      "category": "development",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "下次 pip install 重新下载",
      "paths": ["%LOCALAPPDATA%\\pip\\Cache"],
      "exclude": [],
      "running": [],
      "requires_admin": false,
      "note": "离线安装会因此失效，需重新联网"
    },
    {
      "id": "nuget-http-cache",
      "label": "NuGet HTTP 缓存",
      "description": "包下载的 HTTP 缓存，不是已安装的包",
      "category": "development",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "下次 restore 重新下载",
      "paths": ["%LOCALAPPDATA%\\NuGet\\v3-cache"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "dotnet.exe", "same_user": true }],
      "requires_admin": false,
      "note": "不要与 %USERPROFILE%\\.nuget\\packages 混淆，后者是实际安装的包"
    },
    {
      "id": "nuget-packages",
      "label": "NuGet 全局包目录",
      "description": "已解压的全局包，删掉后离线 restore 会失败",
      "category": "development",
      "status": "release",
      "risk": "caution",
      "action": "delete",
      "regenerates": "需要联网重新 restore",
      "paths": ["%USERPROFILE%\\.nuget\\packages"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "dotnet.exe", "same_user": true }],
      "requires_admin": false,
      "note": "体积大但价值高；只在用户明确同意断网代价时列入"
    },
    {
      "id": "vscode-cache",
      "label": "VS Code 缓存",
      "description": "编辑器缓存与编译缓存，不含扩展和设置",
      "category": "development",
      "status": "release",
      "risk": "safe",
      "action": "delete",
      "regenerates": "启动时重建",
      "paths": ["%APPDATA%\\Code\\Cache", "%APPDATA%\\Code\\CachedData"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "Code.exe", "same_user": true }],
      "requires_admin": false,
      "note": "不含 User\\settings.json、extensions 与 workspaceStorage"
    },
    {
      "id": "docker-desktop-cache",
      "label": "Docker Desktop 缓存",
      "description": "Docker Desktop 的 WSL 磁盘与镜像层缓存",
      "category": "development",
      "status": "pending",
      "risk": "caution",
      "action": "delete",
      "regenerates": "重新拉取镜像",
      "paths": ["%LOCALAPPDATA%\\Docker\\wsl"],
      "exclude": [],
      "running": [{ "type": "exe", "value": "Docker Desktop.exe", "same_user": true }],
      "requires_admin": false,
      "note": "尚未验证：直接删 VHDX 会丢容器与本地镜像，正确做法是 docker system prune 或调整 WSL 磁盘；在验证前保持 pending，不参与候选"
    },
    {
      "id": "downloads",
      "label": "下载文件夹",
      "description": "用户下载的原始文件",
      "category": "protection",
      "status": "release",
      "risk": "never",
      "action": "delete",
      "regenerates": "无法重建",
      "paths": ["%USERPROFILE%\\Downloads"],
      "exclude": [],
      "running": [],
      "requires_admin": false,
      "note": "默认保护；只有用户逐项点名才能处理，注册表不提供批量候选"
    },
    {
      "id": "recycle-bin",
      "label": "回收站",
      "description": "回收站目录本身",
      "category": "protection",
      "status": "release",
      "risk": "never",
      "action": "delete",
      "regenerates": "无法重建",
      "paths": ["%SystemDrive%\\$Recycle.Bin"],
      "exclude": [],
      "running": [],
      "requires_admin": false,
      "note": "清空回收站是独立授权动作，不属于本技能的清理范围"
    }
  ]
}
